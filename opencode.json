{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-qwen-auth"],
  "provider": {
    "qwen": {
      "npm": "@ai-sdk/openai",
      "name": "Qwen (OAuth)",
      "options": {
        "baseURL": "https://portal.qwen.ai/v1",
        "compatibility": "strict"
      },
      "models": {
        "qwen3-coder-plus": {
          "name": "Qwen3 Coder Plus (1M contexto)"
        },
        "qwen3-vl-plus": {
          "name": "Qwen3 VL Plus (visión)",
          "attachment": true
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:1.5b": {
          "name": "Qwen 2.5 Coder 1.5B"
        },
        "deepseek-r1:1.5b": {
          "name": "DeepSeek R1 1.5B"
        }
      }
    },
    "gemini": {
      "npm": "@ai-sdk/google",
      "name": "Gemini Cloud",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-2.0-flash": {
          "name": "Gemini 2.0 Flash"
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        }
      }
    }
  },
  "model": "gemini/gemini-2.5-flash",
  "small_model": "ollama/deepseek-r1:1.5b"
}
