rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: obtener rol del usuario autenticado ───────────
    function getRol() {
      return get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.rol;
    }

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && getRol() == 'admin';
    }

    // ── Catálogos (grados, materias, secciones) ───────────────
    // Solo lectura para autenticados, escritura solo admin
    match /catalogos/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Perfiles de usuario ───────────────────────────────────
    match /perfiles/{userId} {
      // Cada usuario lee y edita su propio perfil
      allow read:   if isAuth() && (request.auth.uid == userId || getRol() in ['admin','coordinacion','docente']);
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
    }

    // ── Asignación de validadores ─────────────────────────────
    match /validadores/{docId} {
      allow read:  if isAuth() && getRol() in ['docente','coordinacion','admin'];
      allow write: if isAuth() && getRol() in ['coordinacion','admin'];
    }

    // ── Proyectos ─────────────────────────────────────────────
    // NOTA: Los campos sugerencias_informatica y complemento_informatica
    // solo se escriben desde Cloud Functions (Admin SDK), que ignora
    // estas reglas. Esto es intencional: evita que el navegador
    // pueda escribir esos campos directamente sin pasar por la
    // validación de rol que hace la función.
    match /proyectos/{proyectoId} {

      // Lectura:
      // - Estudiante: solo si es integrante del proyecto
      // - Docente, coordinación, admin: todos los proyectos
      allow read: if isAuth() && (
        request.auth.uid in resource.data.integrantes ||
        getRol() in ['docente','coordinacion','admin']
      );

      // Crear: solo estudiantes (serán el representante)
      allow create: if isAuth() &&
        getRol() == 'estudiante' &&
        request.auth.uid == request.resource.data.representante_id &&
        request.resource.data.integrantes.size() >= 5 &&
        request.resource.data.integrantes.size() <= 6;

      // Actualizar según rol y estado actual del proyecto
      allow update: if isAuth() && (
        // Estudiante: edita solo si es representante y estado permite edición
        (getRol() == 'estudiante' &&
          request.auth.uid == resource.data.representante_id &&
          resource.data.estado in ['borrador','reclasificar','rechazado_materia'] &&
          resource.data.intentos_envio < 2)
        ||
        // Docente: puede cambiar estado cuando está en revisión
        (getRol() == 'docente' &&
          resource.data.estado in ['registrado','en_revision_materia'])
        ||
        // Coordinación: aprueba o rechaza cuando está en coordinación
        (getRol() == 'coordinacion' &&
          resource.data.estado == 'en_coordinacion')
        ||
        isAdmin()
      );

      // Solo admin puede borrar proyectos
      allow delete: if isAdmin();
    }

    // ── Historial de validaciones ─────────────────────────────
    match /historial/{docId} {
      allow read: if isAuth() && (
        getRol() in ['coordinacion','admin'] ||
        request.auth.uid == resource.data.actor_id ||
        // Estudiante ve historial de su proyecto
        (getRol() == 'estudiante' &&
          exists(/databases/$(database)/documents/proyectos/$(resource.data.proyecto_id)) &&
          request.auth.uid in get(/databases/$(database)/documents/proyectos/$(resource.data.proyecto_id)).data.integrantes)
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.actor_id;
    }
  }
}
