rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isDocente() {
      return isAuthenticated() && getUserRole() == 'docente';
    }

    function isAlumno() {
      return isAuthenticated() && getUserRole() == 'alumno';
    }

    function isCoordinacion() {
      return isAuthenticated() && getUserRole() == 'coordinacion';
    }

    function isRegistroAcademico() {
      return isAuthenticated() && getUserRole() == 'registro_academico';
    }

    function isEnfermeria() {
      return isAuthenticated() && getUserRole() == 'enfermeria';
    }

    function isPsicopedagogia() {
      return isAuthenticated() && getUserRole() == 'psicopedagogico';
    }

    function isStaff() {
      return isAdmin() || isDocente() || isCoordinacion() || 
             isRegistroAcademico() || isEnfermeria() || isPsicopedagogia();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasValidEmailDomain() {
      return isAuthenticated() && 
        request.auth.token.email.matches('.*@salesianosanjose\\.edu\\.sv$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && hasValidEmailDomain();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Approval Requests Collection
    match /approval_requests/{requestId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // New User Notifications Collection
    match /new_user_notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Activity Logs Collection
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // Roles Collection
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Teachers Collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Grades Collection
    match /grades/{gradeId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Sections Collection
    match /sections/{sectionId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Subjects Collection
    match /subjects/{subjectId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Baccalaureate Types Collection
    match /baccalaureate_types/{typeId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Buildings Collection
    match /buildings/{buildingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Computer Labs Collection
    match /computer_labs/{labId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // School Year Status Collection
    match /school_year_status/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Attendance Reports Collection
    match /attendance_reports/{reportId} {
      allow read: if isStaff();
      allow create: if isDocente();
      allow update, delete: if isAdmin();
    }

    // Projects Collection (Semana de la Juventud)
    match /projects/{projectId} {
      allow read: if isStaff() || (isAlumno() && resource.data.studentId == request.auth.uid);
      allow create: if isAlumno() || isDocente();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Global Catch-All Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
