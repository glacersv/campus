rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' ||
        request.auth.token.email == 'admin@salesianosanjose.edu.sv' ||
        request.auth.token.email == 'glacersv@gmail.com'
      );
    }

    function isDocente() {
      return isAuthenticated() && (
        getUserRole() == 'docente' ||
        request.auth.token.email == 'jose.marquez@salesianosanjose.edu.sv' ||
        request.auth.token.email == 'docente@salesianosanjose.edu.sv'
      );
    }

    function isAlumno() {
      return isAuthenticated() && getUserRole() == 'alumno';
    }

    function isCoordinacion() {
      return isAuthenticated() && (
        getUserRole() == 'coordinacion' ||
        getUserRole() == 'coordinacion_academica' ||
        getUserRole() == 'coordinacion_convivencia' ||
        getUserRole() == 'coordinacion_primaria' ||
        getUserRole() == 'coordinacion_parvularia'
      );
    }

    function isRegistroAcademico() {
      return isAuthenticated() && getUserRole() == 'registro_academico';
    }

    function isEnfermeria() {
      return isAuthenticated() && getUserRole() == 'enfermeria';
    }

    function isPsicopedagogia() {
      return isAuthenticated() && (
        getUserRole() == 'psicopedagogio' ||
        getUserRole() == 'psicopedagogico' ||
        getUserRole() == 'psicopedagogia'
      );
    }

    function isStaff() {
      return isAdmin() || isDocente() || isCoordinacion() || 
             isRegistroAcademico() || isEnfermeria() || isPsicopedagogia();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasValidEmailDomain() {
      return isAuthenticated() && 
        request.auth.token.email.matches('.*@salesianosanjose\\.edu\\.sv$');
    }

    // Users Collection
    match /users/{userId} {
      allow list: if isAdmin();
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Approval Requests Collection
    match /approval_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // New User Notifications Collection
    match /new_user_notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Activity Logs Collection
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // Roles Collection
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Teachers Collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Grades Collection
    match /grades/{gradeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Sections Collection
    match /sections/{sectionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Subjects Collection
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Baccalaureate Types Collection
    match /baccalaureate_types/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Buildings Collection
    match /buildings/{buildingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Computer Labs Collection
    match /computer_labs/{labId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // School Year Status Collection
    match /school_year_status/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Attendance Reports Collection
    match /attendance_reports/{reportId} {
      allow read: if isStaff();
      allow create: if isDocente();
      allow update, delete: if isAdmin();
    }

    // Projects Collection (Semana de la Juventud)
    match /proyectos/{projectId} {
      allow read: if isStaff() || isAlumno();
      allow create: if isAlumno() || isDocente();
      allow update: if isStaff() || isAdmin();
      allow update: if isAlumno() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'titulo', 'descripcion', 'grado', 'seccion', 'materia_id', 'materia_nombre',
        'materias_secundarias', 'integrantes', 'integrantes_detalle', 'actividades_evaluadas'
      ]);
      allow delete: if isAdmin() || isDocente();
    }

    // Historial Collection (Proyectos audit trail)
    match /historial/{entryId} {
      allow read: if isStaff() || isAlumno();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isDocente();
    }

    // Actividades Evaluadas Collection
    match /actividades_evaluadas/{actividadId} {
      allow read: if isStaff() || isAlumno();
      allow create: if isDocente() || isAdmin();
      allow update: if isDocente() || isAdmin() || 
        (isAlumno() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['url_entrega']));
      allow delete: if isAdmin() || isDocente();
    }

    // Evaluaciones Informatica Collection (legacy)
    match /evaluaciones_informatica/{evalId} {
      allow read: if isStaff() || isAlumno();
      allow create: if isDocente() || isAdmin();
      allow update: if isDocente() || isAdmin();
      allow delete: if isAdmin();
    }

    // LMS State Collection (single document with courses, modules, activities)
    match /lms_state/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isDocente() || isCoordinacion();
    }

    // LMS Modules (admin structure, docentes pueden escribir contenido)
    match /lms_modules/{moduleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isDocente() || isCoordinacion();
      allow delete: if isAdmin();

      match /{subcollection=**} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isDocente() || isCoordinacion();
      }
    }

    // LMS Module Content (docente editable)
    match /lms_module_content/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isDocente() || isCoordinacion();
    }

    // LMS Calendar (admin created)
    match /lms_calendar/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isDocente() || isCoordinacion();
    }

    // LMS Submissions (entregas de actividades por alumnos)
    match /lms_submissions/{submissionId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Institutional Calendar (admin creates, docentes read for cronograma)
    match /institutional_calendar/{year} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Validadores Collection (Semana de la Juventud)
    match /validadores/{validadorId} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isAdmin();
    }

    // Calendar Events Collection
    match /calendar_events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Global Catch-All Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
